<!doctype html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Критерии беспорядка в ячейках — РЦ «Порядок»</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800&display=swap">
<style>
:root{
  --green:#2E6B24;--green2:#4FA337;--canvas:#EFF6EA;--ink:#14300F;--ink2:#2F4A26;--muted:#63805A;--border:#CBE0C0;
  --item:#2E6B24;
  --brak:#C92123;--liq:#3F8F2A;
  --cap:#F4F7F1;--capb:var(--border);--r:14px;
  --tabh:64px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;font-family:'Golos Text','Segoe UI',Roboto,Arial,sans-serif;color:var(--ink);background:var(--canvas);line-height:1.45;font-size:16px}
a{color:inherit;text-decoration:none}
button{font-family:inherit;font-size:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--green2);outline-offset:2px}
img{max-width:100%;display:block}
[hidden]{display:none!important}

/* ---------- header ---------- */
.top{position:fixed;top:0;left:0;right:0;z-index:30;background:var(--green);color:#fff;padding-top:env(safe-area-inset-top,0px);box-shadow:0 2px 14px rgba(20,48,15,.28)}
.top .in{max-width:1120px;margin:0 auto;padding:10px 16px 7px;display:flex;align-items:center;gap:14px}
.top .home{display:flex;align-items:center;gap:12px;background:none;border:0;color:#fff;padding:0}
.top .home img{height:26px}
.top .home span{font-weight:800;font-size:17px;white-space:nowrap}
.tabswrap{max-width:1120px;margin:0 auto;padding:0 16px 10px;display:flex;align-items:center;gap:10px}
.tlabel{flex-shrink:0;font-size:11.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:rgba(255,255,255,.65)}
.tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.tabs::-webkit-scrollbar{display:none}
.tab{flex-shrink:0;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.14);color:#fff;border-radius:100px;padding:10px 20px;font-weight:700;font-size:15px;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.1)}
.tab:hover{background:rgba(255,255,255,.26)}
.tab.on{background:#fff;color:var(--green);border-color:#fff}

body{padding-top:var(--headH,92px)}
main{max-width:1120px;margin:0 auto;padding:18px 16px 40px}

/* ---------- verdict badge ---------- */
.v{display:inline-flex;align-items:center;gap:7px;border-radius:100px;padding:5px 14px 5px 5px;font-weight:800;font-size:15px;color:#fff;white-space:nowrap}
.v i{font-style:normal;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.28);display:inline-flex;align-items:center;justify-content:center;font-size:13px}
.v.brak{background:var(--brak)}.v.liq{background:var(--liq)}
.v small{font-weight:600;font-size:12.5px;opacity:.92}

/* ---------- home ---------- */
.hero{background:var(--green);color:#fff;border-radius:var(--r);padding:22px 20px;margin-bottom:16px}
.hero .k{font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;opacity:.75}
.hero h1{font-size:clamp(28px,6vw,40px);line-height:1.1;margin:6px 0 6px;font-weight:800}
.hero p{margin:0;opacity:.9;max-width:60ch}
.panel{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:16px 18px;margin-bottom:16px}
.lbl{font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin:0 0 12px}
.leg{display:flex;flex-wrap:wrap;gap:18px}
.leg div{display:flex;align-items:center;gap:12px;font-size:15px}
.warn{margin-top:16px;display:flex;gap:12px;align-items:center;background:#fff;border:1px dashed var(--border);border-radius:var(--r);padding:14px 16px;color:var(--ink2);font-size:15px}
.warn b{color:var(--ink)}
.warn .ex{flex-shrink:0;width:32px;height:32px;border-radius:50%;background:var(--green);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center}

/* ---------- section ---------- */
.grp{margin:22px 0 8px}
.grp-h{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px}
.grp-h .no{flex-shrink:0;width:34px;height:34px;border-radius:9px;background:var(--item);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:16px}
.grp-h h2{margin:2px 0 0;font-size:21px;line-height:1.2}
.grp-h p{margin:2px 0 0;color:var(--muted);font-size:14px}
.cards{display:grid;grid-template-columns:1fr;gap:14px}
@media (min-width:821px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
.case{background:#fff;border:1px solid var(--border);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.case .hd{padding:14px 16px;display:flex;flex-direction:column;align-items:flex-start;gap:9px}
.case .t{font-size:16px;font-weight:500}
.exc{font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--muted);background:var(--canvas);border:1px solid var(--border);border-radius:6px;padding:2px 8px}
.ph{border:0;padding:0;background:#F4F7F1;border-top:1px solid #E4EEDD;display:block;width:100%;position:relative;cursor:zoom-in}
.ph img{width:100%;height:220px;object-fit:contain;margin:0 auto}
.ph .zoom{position:absolute;right:10px;bottom:10px;background:rgba(20,48,15,.72);color:#fff;border-radius:100px;font-size:12px;font-weight:600;padding:4px 10px}
.cap{margin-top:auto;background:var(--cap);border-top:1px solid var(--capb);padding:11px 16px;font-size:15px}
.cap b{color:var(--item)}
.toTop{display:flex;justify-content:center;margin:26px 0 0}
.toTop button{border:1px solid var(--border);background:#fff;border-radius:100px;padding:10px 20px;font-weight:600;color:var(--green)}

/* ---------- quiz ---------- */
.score{position:sticky;top:calc(var(--headH,92px) + 8px);z-index:6;background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;gap:12px;font-weight:600;box-shadow:0 6px 16px rgba(20,48,15,.14)}
.score b{font-size:22px;color:var(--green);font-variant-numeric:tabular-nums}
.score button{margin-left:auto;border:1px solid var(--border);background:#fff;border-radius:100px;padding:7px 14px;font-weight:600;color:var(--green)}
.qgrid{display:grid;grid-template-columns:1fr;gap:14px}
@media (min-width:600px){.qgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:980px){.qgrid{grid-template-columns:repeat(3,minmax(0,1fr))}}
.q{background:#fff;border:1px solid var(--border);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.q .ph img{height:190px;object-fit:cover;max-height:none}
.q .body{padding:12px 14px;display:flex;flex-direction:column;gap:10px;flex:1}
.q .qt{font-weight:600}
.opts{display:flex;flex-wrap:wrap;gap:6px}
.opt{border:2px solid var(--border);background:#fff;border-radius:100px;padding:6px 12px;font-weight:700;font-size:14px}
.opt:disabled{cursor:default;opacity:.45}
.opt.right{opacity:1;border-color:currentColor;background:#F2FAEE;color:var(--liq)}
.opt.wrong{opacity:1;border-color:var(--brak);background:#FBE9E9;color:var(--brak)}
.res{font-size:14.5px;border-radius:10px;padding:9px 12px}
.res.ok{background:#E6F3DF}.res.no{background:#FBE9E9}

/* ---------- lightbox ---------- */
.lb{position:fixed;inset:0;z-index:100;background:rgba(8,18,6,.94);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:calc(56px + env(safe-area-inset-top,0px)) 10px calc(20px + env(safe-area-inset-bottom,0px))}
.lb img{max-width:100%;max-height:78vh;object-fit:contain;border-radius:8px;background:#fff}
.lb .cap2{color:#fff;margin-top:12px;text-align:center;max-width:680px;font-size:15px}
.lb .x{position:absolute;top:calc(10px + env(safe-area-inset-top,0px));right:12px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(255,255,255,.16);color:#fff;font-size:26px;line-height:1}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style></head>
<body>
<header class="top">
  <div class="in"><button class="home" data-go="home"><img src="data:image/png;base64," alt="Порядок"><span>Порядок в ячейках</span></button></div>
  <div class="tabswrap"><span class="tlabel">Разделы</span>
    <nav class="tabs" aria-label="Разделы">
      <button class="tab" data-go="home">Критерии</button>
      <button class="tab" data-go="quiz">Проверь себя</button>
    </nav>
  </div>
</header>

<main id="app"></main>

<div class="lb" id="lb" hidden role="dialog" aria-modal="true"><button class="x" id="lbx" aria-label="Закрыть">×</button><img id="lbimg" alt=""><div class="cap2" id="lbcap"></div></div>

<script>
const IMG={"d1":"data:image/jpeg;base64,","d1x":"data:image/jpeg;base64,","d2":"data:image/jpeg;base64,","d3":"data:image/jpeg;base64,","d4":"data:image/jpeg;base64,","d5":"data:image/jpeg;base64,","d6":"data:image/jpeg;base64,","d7":"data:image/jpeg;base64,","d8":"data:image/jpeg;base64,","d9":"data:image/jpeg;base64,","d10":"data:image/jpeg;base64,","d11":"data:image/jpeg;base64,","q1":"data:image/jpeg;base64,","q2":"data:image/jpeg;base64,","q3":"data:image/jpeg;base64,","q4":"data:image/jpeg;base64,","q5":"data:image/jpeg;base64,"};
const VT={bad:['✕','Нарушение'],ok:['✓','Допускается']};
const badge=v=>`<span class="v ${v==='bad'?'brak':'liq'}"><i>${VT[v][0]}</i>${VT[v][1]}</span>`;

/* ---- ДАННЫЕ: критерии беспорядка в ячейках стеллажного хранения ---- */
const CRIT=[
 {no:'1',h:'Товар без групповой гофрокартонной упаковки',
  c:{t:'Товар лежит на поддоне россыпью, без общей гофроупаковки, в которой он должен приходить от поставщика.',v:'bad',img:'d1',cap:'Отдельные товары лежат прямо на поддоне без групповой упаковки.'},
  exc:{t:'Допускается, если товар приходит без упаковки от поставщика (простил обязателен).',v:'ok',img:'d1x',cap:'Канистры поставляются без картонной упаковки от поставщика — так и должно быть.'}},
 {no:'2',h:'Остатки расходных материалов, излишний картон и стретч-плёнка',
  c:{t:'На поддоне и рядом с ним остаются обрывки стретч-плёнки, лишний картон и другие расходные материалы после переборки товара.',v:'bad',img:'d2',cap:'После переборки на поддоне остались обрывки плёнки и картона.'}},
 {no:'3',h:'Запрещается вскрывать групповую упаковку сбоку или с торца',
  c:{t:'Групповую (заводскую) упаковку вскрывают только сверху. Вскрытие сбоку или с торца портит короб и товар внутри.',v:'bad',img:'d3',cap:'Короб вскрыт сбоку, а не сверху.'}},
 {no:'4',h:'Хранение товара без поддона',
  c:{t:'Товар стоит или лежит прямо на полу ячейки, не установлен на поддон.',v:'bad',img:'d4',cap:'Товар лежит на полу ячейки без поддона.'}},
 {no:'5',h:'Нахождение в ячейке поддона без товара',
  c:{t:'В ячейке остаётся пустой поддон без товара — ячейку нужно освобождать или заполнять.',v:'bad',img:'d5',cap:'Пустой поддон занимает ячейку.'}},
 {no:'6',h:'Брак в ячейке',
  c:{t:'В ячейке хранится повреждённый, бракованный товар вместе с исправным.',v:'bad',img:'d6',cap:'Повреждённая упаковка и брак остаются в ячейке.'}},
 {no:'7',h:'Мусор в ячейке',
  c:{t:'В ячейке скапливается мусор: обрывки плёнки, картона и другие отходы.',v:'bad',img:'d7',cap:'В ячейке скопился мусор.'}},
 {no:'8',h:'Поддон брошен в ряду, не поставлен в ячейку',
  c:{t:'Поддон с товаром оставлен в проезде между стеллажами, а не установлен в свою ячейку.',v:'bad',img:'d8',cap:'Поддон стоит в проезде, а не в ячейке.'}},
 {no:'9',h:'Пустые короба в ячейке',
  c:{t:'В ячейке остаётся пустая коробка без товара.',v:'bad',img:'d9',cap:'Пустой короб в ячейке.'}},
 {no:'10',h:'Несоблюдение рядности при отборе',
  c:{t:'После отбора товар возвращают в ячейку не по своему ряду и не на своё место.',v:'bad',img:'d10',cap:'Товар стоит не по своему ряду после отбора.'}},
 {no:'11',h:'Хранение жидкостей в горизонтальном положении',
  c:{t:'Канистры и бутылки с жидкостью хранятся лёжа на боку, а не вертикально — это создаёт риск протечки.',v:'bad',img:'d11',cap:'Канистры с жидкостью лежат на боку, видны подтёки.'}}
];

const QUIZ=[
 {img:'q1',q:'Какой критерий беспорядка изображён на фото?',options:['Товар без групповой упаковки','Пустые короба в ячейке','Хранение товара без поддона'],a:'Товар без групповой упаковки',why:'Отдельные товары лежат на поддоне россыпью, без общей упаковки.'},
 {img:'q2',q:'Какой критерий беспорядка изображён на фото?',options:['Остатки расходных материалов и стретч-плёнки','Хранение товара без поддона','Пустые короба в ячейке'],a:'Остатки расходных материалов и стретч-плёнки',why:'На поддоне остались обрывки стретч-плёнки и картона после переборки.'},
 {img:'q3',q:'Какой критерий беспорядка изображён на фото?',options:['Групповая упаковка вскрыта сбоку или с торца','Товар без групповой упаковки','Хранение товара без поддона'],a:'Групповая упаковка вскрыта сбоку или с торца',why:'Короб вскрыт сбоку, а не сверху — так делать нельзя.'},
 {img:'q4',q:'Какой критерий беспорядка изображён на фото?',options:['Поддон брошен в ряду, не поставлен в ячейку','Нахождение в ячейке поддона без товара','Пустые короба в ячейке'],a:'Поддон брошен в ряду, не поставлен в ячейку',why:'Поддон стоит в проезде между стеллажами, а не в своей ячейке.'},
 {img:'q5',q:'Какой критерий беспорядка изображён на фото?',options:['Мусор в ячейке','Остатки расходных материалов и стретч-плёнки','Брак в ячейке'],a:'Мусор в ячейке',why:'На полу скопились обрывки плёнки и картона — это мусор.'},
 {q:'Если товар приходит от поставщика совсем без упаковки — это всегда нарушение.',options:['Верно','Неверно'],a:'Неверно',why:'Допускается, если товар приходит без упаковки от поставщика (простил обязателен).'},
 {q:'Пустой поддон, оставленный в ячейке без товара, — тоже беспорядок.',options:['Верно','Неверно'],a:'Верно',why:'Ячейку нужно освобождать или заполнять — пустой поддон занимать место не должен.'},
 {q:'Групповую упаковку можно вскрывать сбоку или с торца, если так удобнее для отбора.',options:['Верно','Неверно'],a:'Неверно',why:'Вскрывать групповую упаковку сбоку или с торца запрещено.'},
 {q:'Хранить канистру с жидкостью на боку можно, если крышка закручена плотно.',options:['Верно','Неверно'],a:'Неверно',why:'Жидкости нужно хранить вертикально — горизонтальное положение считается беспорядком независимо от крышки.'},
 {q:'Пустой короб можно оставить в ячейке до конца смены, если он не мешает работе.',options:['Верно','Неверно'],a:'Неверно',why:'Пустые короба в ячейке — отдельный критерий беспорядка, убирать нужно сразу.'},
 {q:'Несоблюдение рядности при отборе — это тоже критерий беспорядка.',options:['Верно','Неверно'],a:'Верно',why:'Товар должен возвращаться на своё место по ряду, иначе это тоже нарушение.'}
];

const app=document.getElementById('app');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function photoBtn(id,cap){return `<button class="ph" data-img="${id}" data-cap="${esc(cap||'')}"><img src="${IMG[id]}" alt="" loading="lazy"><span class="zoom">⤢ увеличить</span></button>`}
function caseCard(c,isExc){
  return `<article class="case"><div class="hd">${isExc?'<span class="exc">Исключение</span>':''}${badge(c.v)}<div class="t">${esc(c.t)}</div></div>${photoBtn(c.img,c.cap)}<div class="cap"><b>На фото:</b> ${esc(c.cap)}</div></article>`;
}
function renderHome(){
  let body='';
  CRIT.forEach(g=>{
    const cards=caseCard(g.c,false)+(g.exc?caseCard(g.exc,true):'');
    body+=`<section class="grp" id="g-${g.no}"><div class="grp-h"><span class="no">${g.no}</span><div><h2>${esc(g.h)}</h2></div></div><div class="cards">${cards}</div></section>`;
  });
  app.innerHTML=`<div class="hero"><div class="k">памятка</div><h1>Критерии беспорядка в ячейках</h1><p>Эти критерии используются при проверке ячеек стеллажного хранения. Если хотя бы один пункт не соблюдается — ячейка считается в беспорядке.</p></div>
  <div class="panel"><div class="lbl">Обозначения</div><div class="leg">
    <div>${badge('bad')}<span>нарушение — так быть не должно</span></div>
    <div>${badge('ok')}<span>допустимое исключение из правила</span></div>
  </div></div>
  ${body}
  <div class="warn"><span class="ex">!</span><span><b>Сомневаетесь, можно ли так оставить товар?</b> Уточните у старшего зоны или руководителя.</span></div>
  <div class="toTop"><button data-go="quiz" style="border-color:var(--green);color:var(--green);font-weight:800">Проверить себя ›</button></div>`;
}
let qs={};
function renderQuiz(){
  const done=Object.keys(qs).length,ok=Object.values(qs).filter(Boolean).length;
  app.innerHTML=`<div class="hero"><div class="k">самопроверка</div><h1>Проверь себя</h1><p>Посмотрите на фото или прочитайте утверждение и выберите ответ.</p></div>
  <div class="score">Верно: <b>${ok} / ${QUIZ.length}</b>${done?'<button data-reset>Заново</button>':''}</div>
  <div class="qgrid">${QUIZ.map((q,i)=>{
    const a=qs[i];const answered=a!==undefined;
    const opts=q.options.map(o=>{let cls='';if(answered){if(o===q.a)cls=' right';else if(o===q.pick)cls=' wrong'}return `<button class="opt${cls}" data-q="${i}" data-v="${esc(o)}" ${answered?'disabled':''}>${esc(o)}</button>`}).join('');
    const photo=q.img?photoBtn(q.img,q.q):'';
    return `<div class="q">${photo}<div class="body"><div class="qt"><b>${i+1}.</b> ${esc(q.q)}</div><div class="opts">${opts}</div>${answered?`<div class="res ${a?'ok':'no'}">${a?'Верно!':'Правильно: <b>'+esc(q.a)+'</b>.'} ${esc(q.why)}</div>`:''}</div></div>`;
  }).join('')}</div>
  <div class="toTop"><button data-go="home">← К критериям</button></div>`;
}
const VIEWS=['home','quiz'];
function route(){
  const v=VIEWS.includes(location.hash.slice(1))?location.hash.slice(1):'home';
  if(v==='quiz')renderQuiz();else renderHome();
  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.go===v));
  window.scrollTo({top:0,behavior:'instant'});
}
window.addEventListener('hashchange',route);
function syncHeaderHeight(){document.documentElement.style.setProperty('--headH',document.querySelector('.top').offsetHeight+'px')}
window.addEventListener('resize',syncHeaderHeight);
window.addEventListener('orientationchange',syncHeaderHeight);
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(syncHeaderHeight);
syncHeaderHeight();
document.addEventListener('click',e=>{
  const go=e.target.closest('[data-go]');if(go){const v=go.dataset.go;if(location.hash.slice(1)===v)route();else location.hash=v;return}
  if(e.target.closest('[data-reset]')){qs={};renderQuiz();return}
  const o=e.target.closest('.opt');if(o&&!o.disabled){const i=+o.dataset.q;QUIZ[i].pick=o.dataset.v;qs[i]=(o.dataset.v===QUIZ[i].a);const y=window.scrollY;renderQuiz();window.scrollTo(0,y);return}
  const p=e.target.closest('.ph');if(p){lbimg.src=IMG[p.dataset.img];lbcap.textContent=p.dataset.cap;lb.hidden=false;return}
});
const lb=document.getElementById('lb'),lbimg=document.getElementById('lbimg'),lbcap=document.getElementById('lbcap');
lb.addEventListener('click',e=>{if(e.target!==lbimg)lb.hidden=true});
document.getElementById('lbx').addEventListener('click',()=>lb.hidden=true);
document.addEventListener('keydown',e=>{if(e.key==='Escape')lb.hidden=true});
route();
</script>
</body></html>
